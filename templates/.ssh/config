Include config.d/*

AddKeysToAgent yes
UseKeychain yes
SecurityKeyProvider $SSH_SK_PROVIDER

IdentitiesOnly yes
PreferredAuthentications publickey

Host github-* gitlab-* bitbucket-*
	User git
	ControlMaster auto
	ControlPath ~/.ssh/socket/cm-%C
	ControlPersist 1m

Host github-*
	Hostname github.com
